# AI Service — desarrollo local
# Copiar a .env: copy .env.example .env
# Este archivo SÍ se sube a git. El .env real NO.

PORT=8001
MCP_SERVER_URL=http://127.0.0.1:8002

# Gemini 3.5 — reemplazo de 2.5-flash (retiro ~oct 2026)
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.5-flash
LLM_FALLBACK_MODEL=gemini-3.5-flash-lite
GOOGLE_GEMINI_API_KEY=
GEMINI_API_KEY=

# Máximo de tarjetas en payloads Rich UI (alinear con NEXT_PUBLIC_MAX_UI_CARDS). Default: 8
MAX_UI_CARDS=8
