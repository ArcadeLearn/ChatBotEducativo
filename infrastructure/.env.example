# =============================================================================
# ChatBotEducativo — Variables del stack completo (Docker Compose)
# Copiar a .env y completar los valores vacíos antes de: docker compose up -d
# Este archivo SÍ se sube a git (.env.example). El .env real NO.
# =============================================================================

# --- PostgreSQL ---
DATABASE_PASSWORD=
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/edu_chatbot_db

# --- Backend NestJS (:4001) ---
PORT=4001
NODE_ENV=development
JWT_SECRET=
JWT_EXPIRES_IN=7d
CORS_ORIGINS=http://localhost:3001,http://127.0.0.1:3001,http://localhost:3005

# URLs internas (red Docker)
AI_SERVICE_URL=http://ai-service:8001
MCP_SERVER_URL=http://mcp-server:8002

# --- AI Service FastAPI (:8001) ---
AI_PORT=8001
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.7-flash
LLM_FALLBACK_MODEL=gemini-3.5-flash-lite
GOOGLE_GEMINI_API_KEY=

# LangSmith (opcional)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=chatbot-educativo

# --- MCP Server FastAPI (:8002) ---
MCP_PORT=8002
DATA_DIR=/app/data

# --- Frontend Next.js (:3001) ---
NEXT_PUBLIC_API_URL=http://localhost:4001
NEXT_PUBLIC_EDU_CHAT_URL=http://localhost:4001
