# ChatBotEducativo - Produccion interna (sin DNS publico)

NODE_ENV=production

# Backend interno
PORT=4001
AI_SERVICE_URL=http://127.0.0.1:8001
JWT_SECRET=
JWT_EXPIRES_IN=7d
CORS_ORIGINS=https://iecacampus.arcadevs.cloud

# Postgres existente en n8n_default (nueva BD dedicada)
DATABASE_URL=postgresql://edu_chatbot_user:reemplazar_password@n8n-postgres:5432/edu_chatbot_db

# AI Service
AI_PORT=8001
MCP_SERVER_URL=http://127.0.0.1:8002
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.7-flash
LLM_FALLBACK_MODEL=gemini-3.5-flash-lite
GOOGLE_GEMINI_API_KEY=
MAX_UI_CARDS=8
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=chatbot-educativo

# MCP Server
MCP_PORT=8002
DATA_DIR=/app/mcp-server/data

# Frontend embebido via campusdemo
FRONTEND_PORT=3001
NEXT_PUBLIC_API_URL=https://iecacampus.arcadevs.cloud/api/edu-chat-proxy
NEXT_PUBLIC_EDU_CHAT_URL=https://iecacampus.arcadevs.cloud/api/edu-chat-proxy
