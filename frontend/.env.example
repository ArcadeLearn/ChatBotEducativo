# Frontend Next.js — desarrollo local
# Copiar a .env.local: copy .env.example .env.local
# Este archivo SÍ se sube a git. .env.local NO.

NEXT_PUBLIC_API_URL=http://localhost:4001
NEXT_PUBLIC_EDU_CHAT_URL=http://localhost:4001

# Máximo de tarjetas Rich UI visibles en el chat (catálogo, certificados, avisos). Default: 8
NEXT_PUBLIC_MAX_UI_CARDS=8
